\name{CTTB-package}
\alias{CTTB-package}
\title{CTTB: Covariate-Tightened Trimming Bounds}
\description{Tools for estimating trimming bounds using covariates.}
\details{
The package provides functions for estimating classic Lee bounds,
covariate-tightened trimming bounds, and conditional bounds under endogenous
outcome missingness or sample selection.
}
